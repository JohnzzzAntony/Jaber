# Production environment - Configure on Railway Dashboard
NODE_ENV="production"

# Database - Set DATABASE_URL via Railway PostgreSQL addon
# DATABASE_URL will be auto-injected by Railway PostgreSQL plugin

# NextAuth - Must be set in Railway environment
# NEXTAUTH_URL=https://your-app.railway.app
# NEXTAUTH_SECRET=your-production-secret

# API
NEXT_PUBLIC_API_URL="https://your-app.railway.app"

# Build flags for production
SKIP_ENV_VALIDATION="false"
