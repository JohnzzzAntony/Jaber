{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install && npm run build",
    "startCommand": "node .next/standalone/server.js"
  },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "restartPolicyMaxRetries": 10
  },
  "variables": {
    "PORT": {
      "description": "Port to run the application on",
      "value": "3000"
    },
    "NODE_ENV": {
      "description": "Node environment",
      "value": "production"
    },
    "NEXTAUTH_SECRET": {
      "description": "NextAuth secret key for production",
      "value": "",
      "scope": "production"
    },
    "NEXTAUTH_URL": {
      "description": "NextAuth URL (auto-set by Railway)",
      "reference": "${{ RAILWAY_DOMAIN }}"
    }
  }
}
